# Caminho do arquivo SQLite. Em producao use o disco persistente (ex.: /data/app.db).
DATABASE_PATH=./data/app.db

# Porta do servidor (Next usa 3000 por padrao).
# PORT=3000

# Cidade fixa do MVP (RN/REQUISITOS secao 2). Nao alterar sem decisao de produto.
CIDADE_PADRAO=Rio Branco/AC

# Segredo para assinar o cookie de sessao do lojista (auth).
SESSION_SECRET=troque-isto-em-producao
